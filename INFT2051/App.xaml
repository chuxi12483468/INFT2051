<?xml version = "1.0" encoding = "UTF-8" ?>

<!-- Root application definition for the MAUI app -->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:INFT2051"
             x:Class="INFT2051.App">

    <!-- Global resources available across the entire application -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- Merge external resource dictionaries (styles and colors) -->
            <ResourceDictionary.MergedDictionaries>

                <!-- Defines color variables used throughout the app -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />

                <!-- Defines UI styles such as buttons, labels, layouts -->
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>
