<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051.DiaryEditPage"
             Title="Edit Diary">

    <Grid Padding="20" RowDefinitions="*,Auto,Auto">

        <!-- Top content area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="15">

                <Label Text="Diary Title" />
                <Entry x:Name="TitleEntry"
                       Placeholder="Enter diary title" />

                <Label Text="Date" />
                <DatePicker x:Name="DiaryDatePicker" />

                <Label Text="Content" />
                <Editor x:Name="ContentEditor"
                        Placeholder="Write your diary here..."
                        AutoSize="TextChanges"
                        MinimumHeightRequest="250" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Drawing area -->
        <Border Grid.Row="1"
                HeightRequest="320"
                Stroke="Black"
                StrokeThickness="1"
                BackgroundColor="LightGray"
                Padding="10"
                Margin="0,10,0,10">

            <VerticalStackLayout Spacing="10">

                <Label Text="Drawing Area"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">

                    <Button Text="Black"
                            Clicked="OnBlackColorClicked" />

                    <Button Text="Red"
                            Clicked="OnRedColorClicked" />

                    <Button Text="Blue"
                            Clicked="OnBlueColorClicked" />

                    <Button Text="Eraser"
                            Clicked="OnEraserClicked" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">

                    <Button Text="Thin"
                            Clicked="OnThinClicked" />

                    <Button Text="Medium"
                            Clicked="OnMediumClicked" />

                    <Button Text="Thick"
                            Clicked="OnThickClicked" />

                    <Button Text="Clear"
                            Clicked="OnClearDrawingClicked" />
                </HorizontalStackLayout>

                <GraphicsView x:Name="DiaryGraphicsView"
                              HeightRequest="200"
                              BackgroundColor="White"
                              StartInteraction="OnDrawingStart"
                              DragInteraction="OnDrawingDrag"
                              EndInteraction="OnDrawingEnd" />
            </VerticalStackLayout>
        </Border>

        <!-- Bottom buttons -->
        <HorizontalStackLayout Grid.Row="2"
                               Spacing="15"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0">

            <Button Text="Save"
                    Clicked="OnSaveClicked" />

            <Button Text="Delete"
                    Clicked="OnDeleteClicked" />

            <Button Text="Back"
                    Clicked="OnBackClicked" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>